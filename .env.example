# ================== 必填（首次启动前必须全部填写） ==================
# 访问端口。飞牛上 8080 若已被占用，改成 8081 / 9080 等。
HTTP_PORT=8080

# 独立数据库名：飞牛版专用，不要与其它系统共用
DB_NAME=cert_agent_fnos

# MySQL root 密码。建议用 `openssl rand -hex 24` 生成（纯字母数字，避免特殊字符）
DB_ROOT_PASSWORD=

# Redis 密码。Redis 是强依赖，必须非空
REDIS_PASSWORD=

# 管理员初始账号（首次启动自动创建；之后改这里不会重置数据库中的密码）
ADMIN_USER=admin
ADMIN_PASS=
ADMIN_NAME=系统管理员

# 政务网申报密码加密密钥（32 位以上随机串，建议 `openssl rand -hex 32`）
# 安装后不可更换：更换会导致已保存的申报密码无法解密
GOV_PASSWORD_KEY=

# ================== 可选 ==================
# 应用镜像标签
APP_TAG=latest

# 页面「在线升级」在飞牛版固定关闭（docker-compose.yml 注入 PHP_UPGRADE_ENABLED=0），
# 升级请使用 git pull + docker compose up -d --build，无需在此配置。

# Redis 库号 / 键前缀（同一 Redis 多系统共用时用前缀隔离）
REDIS_DB=0
REDIS_PREFIX=cert:fnos:
