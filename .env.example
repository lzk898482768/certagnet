# ================== 必填（首次启动前必须全部填写） ==================
# 访问端口（宿主机映射端口，容器内部固定 80）。
# 避开 80 / 443 / 8080 等常用端口；如仍被占用，改成其它非常用端口（如 18081 / 28080）。
# 注意：改这里只影响“你用哪个端口访问”，不影响授权（授权只校验域名，不含端口）。
HTTP_PORT=18080

# 独立数据库名：飞牛版专用，不要与其它系统共用
DB_NAME=cert_agent_fnos

# MySQL root 密码。建议用 `openssl rand -hex 24` 生成（纯字母数字，避免特殊字符）
DB_ROOT_PASSWORD=

# Redis 密码。Redis 是强依赖，必须非空
REDIS_PASSWORD=

# 管理员初始账号（首次启动自动创建；之后改这里不会重置数据库中的密码）
ADMIN_USER=admin
ADMIN_PASS=
ADMIN_NAME=系统管理员

# 政务网申报密码加密密钥（32 位以上随机串，建议 `openssl rand -hex 32`）
# 安装后不可更换：更换会导致已保存的申报密码无法解密
GOV_PASSWORD_KEY=

# ================== 可选 ==================
# 镜像名由 Compose 自动生成，不再需要 APP_TAG。
# 不要给 app 服务写 image: 本地镜像名，否则构建前会尝试从 Docker Hub 拉取而卡住。

# ================== 阿里云 ACR（可选） ==================
# 仅在使用 docker-compose.acr.yml（全部镜像从 ACR 拉取）时需要。
# 先用 tools/push-acr.sh 把镜像推送到 ACR；ACR_NAMESPACE 是控制台里创建的命名空间。
ACR_REGISTRY=crpi-e8ivxiujwrjswkb4.cn-beijing.personal.cr.aliyuncs.com
ACR_NAMESPACE=certagent
# 应用镜像仓库名（ACR 控制台里“仓库名称”）
ACR_APP_REPO=certagent
# 建议填 tools/push-acr.sh 输出的版本号；latest 也可，但回滚不方便
ACR_TAG=2.99.86

# 私有仓库登录凭据：
#   - 账号已预置（非密钥）；密码不要写进仓库。
#   - 执行 `sh deploy-acr.sh` 时会隐藏式提示输入一次密码；
#     也可用环境变量 ACR_PASSWORD 传入，或在下方 ACR_PASSWORD= 后填写（.env 不会入库/入镜像）。
ACR_USERNAME=240623475@qq.com
ACR_PASSWORD=

# 如果仍使用默认 docker-compose.yml 在飞牛本地构建，只把基础镜像换成 ACR：
# PHP_BASE_IMAGE=crpi-e8ivxiujwrjswkb4.cn-beijing.personal.cr.aliyuncs.com/certagent/php:8.2-fpm-bookworm
# MYSQL_IMAGE=crpi-e8ivxiujwrjswkb4.cn-beijing.personal.cr.aliyuncs.com/certagent/mysql:8.0
# REDIS_IMAGE=crpi-e8ivxiujwrjswkb4.cn-beijing.personal.cr.aliyuncs.com/certagent/redis:7-alpine

# 页面「在线升级」在飞牛版固定关闭（docker-compose.yml 注入 PHP_UPGRADE_ENABLED=0），
# 升级请使用 git pull + docker compose up -d --build，无需在此配置。

# Redis 库号 / 键前缀（同一 Redis 多系统共用时用前缀隔离）
REDIS_DB=0
REDIS_PREFIX=cert:fnos:

# ================== 性能调优（可选，全部带默认值，不填即用 4GB 基线） ==================
# 设计原则：4GB NAS 为保守默认，高规格 NAS（8/16GB）调大下列参数即可发挥性能。
# 单位：字节（256M=268435456，512M=536848900，1G=1073741824）；改完执行 sh deploy-acr.sh 生效。

# --- MySQL 8（InnoDB）---
# buffer pool 建议为可用内存的 50%~60%；4GB→256M，8GB→512M，16GB→1G
MYSQL_INNODB_BUFFER_POOL_SIZE=268435456
# redo log：4GB→128M，8GB/16GB→256M/512M
MYSQL_INNODB_LOG_FILE_SIZE=134217728
# 1=每次事务刷盘（最安全，默认）；对性能极敏感且可接受极小丢失风险可设 2
MYSQL_INNODB_FLUSH_LOG_AT_TRX_COMMIT=1
MYSQL_MAX_CONNECTIONS=100
MYSQL_TABLE_OPEN_CACHE=1000
MYSQL_TMP_TABLE_SIZE=33554432
MYSQL_MAX_HEAP_TABLE_SIZE=33554432
# 慢查询日志（秒），>2s 的 SQL 落库日志便于排查
MYSQL_SLOW_QUERY_LOG=1
MYSQL_LONG_QUERY_TIME=2

# --- Redis 7 ---
# 内存上限：4GB→256M，8GB→384M，16GB→512M
REDIS_MAXMEMORY=268435456
# 满了只淘汰带 TTL 的 key（缓存/会话），不碰无 TTL 的持久数据
REDIS_MAXMEMORY_POLICY=volatile-lru
# AOF 刷盘：everysec 兼顾性能与安全（默认）；最稳 always，最快 no
REDIS_APPENDFSYNC=everysec
# 客户端空闲超时秒（0=不主动断）
REDIS_TIMEOUT=300

# --- PHP-FPM 进程池（max_children × memory_limit 512M 为理论内存上限，勿盲目调大）---
# 4GB→12，8GB→20，16GB→30
PM_MAX_CHILDREN=12
PM_START_SERVERS=4
PM_MIN_SPARE_SERVERS=2
PM_MAX_SPARE_SERVERS=6
PM_MAX_REQUESTS=500

# --- 定时任务调度器（单位秒）---
# 循环间隔，默认每小时一轮
SCHED_INTERVAL=3600
# 到期检测 / 政务同步的单次超时，超时自动终止并下轮重试，避免卡死整个调度
TASK_TIMEOUT_CHECK=900
TASK_TIMEOUT_GOV=1500
