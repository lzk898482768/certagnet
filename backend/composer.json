{
    "name": "cert-agent/cert-agent",
    "description": "证照到期管理系统（中介版） - ThinkPHP6 + MySQL8 + Vue3",
    "type": "project",
    "keywords": ["cert", "license", "expiry", "thinkphp", "vue"],
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "topthink/framework": "^6.1",
        "topthink/think-orm": "^2.0",
        "phpmailer/phpmailer": "^6.9",
        "phpoffice/phpspreadsheet": "^2.1",
        "predis/predis": "^2.4"
    },
    "require-dev": {},
    "autoload": {
        "psr-4": {
            "app\\": "app/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php think service:discover",
            "@php think vendor:publish"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
