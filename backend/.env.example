APP_DEBUG = true
APP_TRACE = false

[DATABASE]
TYPE = mysql
HOSTNAME = 127.0.0.1
DATABASE = cert_agent
USERNAME = root
PASSWORD = cert_agent123
HOSTPORT = 3306
CHARSET = utf8mb4
PREFIX = ""

# Redis 是必需依赖；不可用时禁止降级为文件缓存。
# [REDIS] 分节由 ThinkPHP 映射为 REDIS_HOST / REDIS_PORT 等变量。
[REDIS]
HOST = "127.0.0.1"
PORT = 6379
PASSWORD = ""
DB = 0
PREFIX = "cert:"

# 在线升级（可选）。私有 Gitee 仓库必须配置 GITEE_TOKEN，
# 令牌在 Gitee「设置 → 私人令牌」生成，勾选 projects 读权限。
# [UPGRADE]
# GITEE_OWNER = "kxunyun"
# GITEE_REPO = "cert-expiry-manager"
# GITEE_TOKEN = ""
# MYSQLDUMP = ""
# MYSQL = ""
# 备份时额外排除的目录（相对 backend，逗号分隔）。runtime 始终排除；
# 附件/上传目录很大时可在此排除，加快备份并避免占用空间。
# BACKUP_EXCLUDE = "public/uploads,public/storage"

# 被控端（授权端在线控制）目标地址限制。
# 默认只允许 https://，并拒绝回环 / 链路本地 / 云元数据地址。
# 内网部署确实需要 http 或 127.0.0.1 时再按需打开（存在 SSRF 风险，务必限定内网）：
# [LICENSE]
# ENDPOINT_ALLOW_HTTP = 1
# ENDPOINT_ALLOW_LOOPBACK = 1
# ENDPOINT_BLOCK_PRIVATE = 1
